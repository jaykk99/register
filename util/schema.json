{"$id":"https://is-a.dev/schema/domain.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"description":"One file per subdomain in domains/<subdomain>.json. See util/validator.js for the enforced rules.","properties":{"description":{"description":"Optional human-readable note about the domain.","type":"string"},"owner":{"properties":{"email":{"description":"Optional contact email. Omit the field instead of leaving it empty.","format":"email","type":"string"},"username":{"description":"The registrant's GitHub username (used for PR ownership checks).","pattern":"^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$","type":"string"}},"required":["username"],"type":"object"},"proxied":{"description":"Route through Cloudflare proxy. Only with proxy-able records (A/AAAA/CNAME, not CNAME+A/AAAA combos).","type":"boolean"},"records":{"description":"DNS records. Keys are record types; values depend on the type.","minProperties":1,"properties":{"A":{"items":{"format":"ipv4","type":"string"},"minItems":1,"type":"array"},"AAAA":{"items":{"format":"ipv6","type":"string"},"minItems":1,"type":"array"},"CAA":{"items":{"properties":{"tag":{"enum":["issue","issuewild","iodef"]},"value":{"type":"string"}},"required":["tag","value"],"type":"object"},"minItems":1,"type":"array"},"CNAME":{"format":"hostname","type":"string"},"DS":{"items":{"properties":{"algorithm":{"maximum":255,"minimum":0,"type":"integer"},"digest":{"pattern":"^[0-9a-fA-F]+$","type":"string"},"digest_type":{"maximum":255,"minimum":0,"type":"integer"},"key_tag":{"maximum":65535,"minimum":0,"type":"integer"}},"required":["key_tag","algorithm","digest_type","digest"],"type":"object"},"minItems":1,"type":"array"},"MX":{"items":{"anyOf":[{"format":"hostname","type":"string"},{"properties":{"priority":{"maximum":65535,"minimum":0,"type":"integer"},"target":{"format":"hostname","type":"string"}},"required":["target","priority"],"type":"object"}]},"minItems":1,"type":"array"},"NS":{"items":{"form